# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB (same database the client uses for BetterAuth)
MONGODB_URI=
MONGODB_DB_NAME=mentorlagbe

# JWT: MUST be exactly the same value as JWT_SECRET in client/.env.local
JWT_SECRET=

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Optional: only needed if you set up the webhook endpoint
STRIPE_WEBHOOK_SECRET=